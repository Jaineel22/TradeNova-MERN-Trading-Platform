MONGO_URL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
PORT=3003

# AI portfolio assistant (Google Gemini API: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Optional - falls back to the built-in production/localhost defaults in
# src/app.js if unset.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Rate limiting (all optional - sensible defaults are baked in)
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# REGISTER_RATE_LIMIT_MAX=5
# ORDER_RATE_LIMIT_WINDOW_MS=60000
# ORDER_RATE_LIMIT_MAX=60
